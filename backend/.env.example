# Copy this file to `.env` and fill in the real value:
#
#   cp .env.example .env
#
# `.env` is gitignored. Never commit it.

# Comma-separated list of browser origins allowed to call this API directly.
#
#   CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000
#
# Leave it unset (the default) to deny every cross-origin request. This is
# the recommended production setting: the frontend reverse-proxies the API
# through its own origin, so browser requests arrive same-origin and never
# need CORS at all.
#
# Swagger UI served by this API is same-origin with the API, so it keeps
# working regardless of this value.
CORS_ORIGINS=