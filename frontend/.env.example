# Copy this file to `.env.local` and fill in the real value:
#
#   cp .env.example .env.local
#
# `.env.local` is gitignored. Never commit it.

# Absolute URL of the FastAPI backend, with no trailing slash.
#
# This is a SERVER-ONLY variable. It is deliberately NOT prefixed with
# `NEXT_PUBLIC_`, because Next.js inlines any `NEXT_PUBLIC_` variable into the
# browser bundle at build time, which would expose the backend URL to every
# visitor via devtools.
#
# The browser never sees this URL: client-side requests go to same-origin
# relative paths such as `/api/v1/issues`, and `next.config.ts` proxies them to
# `API_BASE_URL` on the Next.js server.
#
# On Vercel, set this in the project's Environment Variables. It must be present
# at build time, because the proxy destination is baked into the build.
API_BASE_URL=https://your-backend.onrender.com